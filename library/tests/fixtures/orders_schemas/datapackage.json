{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "shop",
  "resources": [
    {
      "name": "customers",
      "path": "customers.csv",
      "schema": {
        "fields": [
          {"name": "id", "type": "integer", "constraints": {"required": true, "unique": true}},
          {"name": "email", "type": "string", "format": "email", "constraints": {"required": true}}
        ],
        "primaryKey": "id"
      }
    },
    {
      "name": "orders",
      "path": "orders.csv",
      "schema": "orders.tableschema.json"
    },
    {
      "name": "order_lines",
      "path": "order_lines.csv",
      "schema": {
        "fields": [
          {"name": "order_id", "type": "integer", "constraints": {"required": true}},
          {"name": "customer_id", "type": "integer", "constraints": {"required": true}},
          {"name": "quantity", "type": "integer", "constraints": {"minimum": 1, "maximum": 20}}
        ],
        "foreignKeys": [
          {"fields": "order_id", "reference": {"resource": "orders", "fields": "order_id"}},
          {"fields": ["customer_id"], "reference": {"resource": "customers", "fields": ["id"]}}
        ]
      }
    }
  ]
}
