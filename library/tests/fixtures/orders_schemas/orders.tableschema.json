{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "fields": [
    {"name": "order_id", "type": "integer", "constraints": {"required": true, "unique": true, "minimum": 1}},
    {"name": "status", "type": "string", "categories": ["pending", "processing", "shipped", "cancelled"], "constraints": {"required": true}},
    {"name": "priority", "type": "integer", "constraints": {"enum": [1, 2, 3]}},
    {"name": "customer_email", "type": "string", "format": "email", "constraints": {"required": true}},
    {"name": "sku", "type": "string", "constraints": {"required": true, "pattern": "[A-Z]{3}-[0-9]{4}"}},
    {"name": "amount", "type": "number", "constraints": {"required": true, "minimum": 0, "maximum": 10000}},
    {"name": "order_date", "type": "date", "constraints": {"required": true}},
    {"name": "shipped_at", "type": "datetime"},
    {"name": "note", "type": "string"},
    {"name": "order_year", "type": "year"},
    {"name": "location", "type": "geopoint"}
  ],
  "missingValues": ["NA", ""],
  "primaryKey": ["order_id"]
}
