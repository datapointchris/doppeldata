{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doppeldata profile v1",
  "description": "A profile file: one table, or a bundle of tables and their relationships.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "table"
        }
      },
      "$ref": "#/$defs/TableProfile",
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "bundle"
        }
      },
      "$ref": "#/$defs/BundleProfile",
      "required": [
        "kind"
      ]
    }
  ],
  "$defs": {
    "AuditEntry": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "values": {
          "description": "How many literals of the column the profile keeps, where the rule admits a count of them.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "column",
        "rule"
      ]
    },
    "BooleanStats": {
      "type": "object",
      "properties": {
        "true_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BundleProfile": {
      "description": "Several tables' profiles and the relationships between them.",
      "type": "object",
      "properties": {
        "generated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Generated"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "profile_version": {
          "$ref": "#/$defs/ProfileVersion"
        },
        "relationships": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Relationship"
          }
        },
        "tables": {
          "description": "Each table by name: a profile file's path relative to the bundle, or the profile inline.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/BundleTable"
          }
        }
      },
      "required": [
        "profile_version",
        "name",
        "tables"
      ]
    },
    "BundleTable": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/InlineTable"
        }
      ]
    },
    "Cardinality": {
      "type": "string",
      "enum": [
        "one_to_one",
        "one_to_many",
        "many_to_one",
        "many_to_many"
      ]
    },
    "CharClass": {
      "type": "string",
      "enum": [
        "upper",
        "lower",
        "digit",
        "space",
        "punct",
        "other"
      ]
    },
    "Charset": {
      "type": "object",
      "properties": {
        "ascii": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "classes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/CharClass"
          }
        }
      }
    },
    "CheckDigit": {
      "oneOf": [
        {
          "description": "The mod-10 digit of payment card numbers.",
          "type": "string",
          "const": "luhn"
        }
      ]
    },
    "Column": {
      "description": "One column, or one field nested in a list or struct column.",
      "type": "object",
      "properties": {
        "boolean": {
          "anyOf": [
            {
              "$ref": "#/$defs/BooleanStats"
            },
            {
              "type": "null"
            }
          ]
        },
        "distinct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distinct"
            },
            {
              "type": "null"
            }
          ]
        },
        "list": {
          "anyOf": [
            {
              "$ref": "#/$defs/ListStats"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogicalType"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_tokens": {
          "description": "Tokens a text source uses for a missing value, with the share of rows holding each.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Rate"
          }
        },
        "name": {
          "description": "The column's name. A list's element is named `element`.",
          "type": "string"
        },
        "null_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "nullable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "numeric": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericStats"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "description": "The dotted path to a nested field.",
          "type": [
            "string",
            "null"
          ]
        },
        "physical_type": {
          "description": "An Arrow type string, such as `decimal128(12, 2)`.",
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quality"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Semantic"
            },
            {
              "type": "null"
            }
          ]
        },
        "string": {
          "anyOf": [
            {
              "$ref": "#/$defs/StringStats"
            },
            {
              "type": "null"
            }
          ]
        },
        "struct": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructStats"
            },
            {
              "type": "null"
            }
          ]
        },
        "temporal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalStats"
            },
            {
              "type": "null"
            }
          ]
        },
        "type_mix": {
          "description": "The share of raw values parsing as each type. The shares sum to 1.",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "boolean": {
              "$ref": "#/$defs/Rate"
            },
            "date": {
              "$ref": "#/$defs/Rate"
            },
            "decimal": {
              "$ref": "#/$defs/Rate"
            },
            "integer": {
              "$ref": "#/$defs/Rate"
            },
            "string": {
              "$ref": "#/$defs/Rate"
            },
            "timestamp": {
              "$ref": "#/$defs/Rate"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name"
      ]
    },
    "Compression": {
      "type": "string",
      "enum": [
        "none",
        "gzip",
        "bzip2",
        "zstd",
        "snappy",
        "lz4",
        "lzo"
      ]
    },
    "Conditional": {
      "description": "The distribution of `column` within each value of `given`. Each row of `table` sums to 1.",
      "type": "object",
      "properties": {
        "column": {
          "type": "string"
        },
        "given": {
          "type": "string"
        },
        "table": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/Rate"
            }
          }
        }
      },
      "required": [
        "given",
        "column",
        "table"
      ]
    },
    "Correlation": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/CorrelationMethod"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "a",
        "b",
        "method",
        "value"
      ]
    },
    "CorrelationMethod": {
      "type": "string",
      "enum": [
        "pearson",
        "spearman",
        "kendall",
        "cramers_v"
      ]
    },
    "Dataset": {
      "description": "Facts about the table as a whole.",
      "type": "object",
      "properties": {
        "conditionals": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Conditional"
          }
        },
        "correlations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Correlation"
          }
        },
        "dependencies": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        },
        "duplicate_row_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "keys": {
          "anyOf": [
            {
              "$ref": "#/$defs/Keys"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DependencyKind"
        },
        "lhs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rhs": {
          "type": "string"
        },
        "violation_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "lhs",
        "rhs"
      ]
    },
    "DependencyKind": {
      "oneOf": [
        {
          "description": "`lhs` determines `rhs`.",
          "type": "string",
          "const": "functional"
        }
      ]
    },
    "Detector": {
      "type": "string",
      "enum": [
        "pattern",
        "check_digit",
        "presidio",
        "glue",
        "name_hint"
      ]
    },
    "DifferentialPrivacy": {
      "type": "object",
      "properties": {
        "delta": {
          "type": "number",
          "format": "double"
        },
        "epsilon": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "epsilon",
        "delta"
      ]
    },
    "Distinct": {
      "type": "object",
      "properties": {
        "approx": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Engine": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "polars",
            "duckdb",
            "spark"
          ]
        },
        {
          "description": "Read from a catalog or a data contract rather than computed from data.",
          "type": "string",
          "const": "import"
        }
      ]
    },
    "ExtremesMethod": {
      "oneOf": [
        {
          "description": "The true minimum and maximum, written only under a policy that allows them.",
          "type": "string",
          "const": "exact"
        },
        {
          "description": "The values at rank `k_min` from each end.",
          "type": "string",
          "const": "trimmed_k"
        }
      ]
    },
    "Fanout": {
      "description": "Children per parent: the join skew a Spark comparison needs.",
      "type": "object",
      "properties": {
        "quantiles": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantiles"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_share": {
          "description": "The share of child rows the busiest parents hold: `top1`, `top10`, `top100`.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Rate"
          }
        },
        "zipf_s": {
          "description": "The exponent of a Zipf fit to children per parent.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "FileCounts": {
      "type": "object",
      "properties": {
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "size_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileSizes"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "FileSizes": {
      "type": "object",
      "properties": {
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "total": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "Fit": {
      "description": "A fitted distribution, named as scipy.stats names it, with its parameters.",
      "type": "object",
      "properties": {
        "aic": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "family": {
          "type": "string"
        },
        "ks": {
          "description": "The Kolmogorov-Smirnov statistic of the fit.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "sample": {
          "description": "The rows the fit was made on.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "family",
        "params"
      ]
    },
    "Generated": {
      "description": "How and when the profile was made. `at` and `tool` are left out of the profile's digest.",
      "type": "object",
      "properties": {
        "at": {
          "description": "When profiling finished, in RFC 3339.",
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "anyOf": [
            {
              "$ref": "#/$defs/Engine"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sample"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_fingerprint": {
          "description": "A hash of the source's paths, sizes and modification times, never its content.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "The tool and its version, as `doppeldata <version>`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GeneratorHint": {
      "type": "object",
      "properties": {
        "check_digit": {
          "description": "The check digit a value's last digit holds. `quality.invalid_rate` of values hold a wrong one.",
          "anyOf": [
            {
              "$ref": "#/$defs/CheckDigit"
            },
            {
              "type": "null"
            }
          ]
        },
        "pattern": {
          "description": "A regular expression every value matches. It takes the place of `string.pattern`.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Granularity": {
      "type": "string",
      "enum": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second",
        "millisecond",
        "microsecond",
        "nanosecond"
      ]
    },
    "Histogram": {
      "description": "Bin edges and the rows in each bin. `counts` has one entry fewer than `edges`.",
      "type": "object",
      "properties": {
        "counts": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "kind": {
          "$ref": "#/$defs/HistogramKind"
        }
      },
      "required": [
        "kind",
        "edges",
        "counts"
      ]
    },
    "HistogramKind": {
      "type": "string",
      "enum": [
        "equal_depth",
        "equal_width"
      ]
    },
    "InlineTable": {
      "description": "A table profile written inside a bundle, as its own file would hold it.",
      "type": "object",
      "properties": {
        "columns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dataset"
            },
            {
              "type": "null"
            }
          ]
        },
        "generated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Generated"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/TableKind"
        },
        "name": {
          "type": "string"
        },
        "privacy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Privacy"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_version": {
          "$ref": "#/$defs/ProfileVersion"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "profile_version",
        "name"
      ]
    },
    "Key": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uniqueness": {
          "description": "The share of rows whose key value no other row holds.",
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "columns"
      ]
    },
    "Keys": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Key"
          }
        },
        "primary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Key"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Layout": {
      "type": "object",
      "properties": {
        "files": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileCounts"
            },
            {
              "type": "null"
            }
          ]
        },
        "partitioning": {
          "anyOf": [
            {
              "$ref": "#/$defs/Partitioning"
            },
            {
              "type": "null"
            }
          ]
        },
        "rows_per_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantiles"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort_order": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LengthStats": {
      "type": "object",
      "properties": {
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mean": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "quantiles": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantiles"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ListStats": {
      "type": "object",
      "properties": {
        "element": {
          "anyOf": [
            {
              "$ref": "#/$defs/Column"
            },
            {
              "type": "null"
            }
          ]
        },
        "empty_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "length": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantiles"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LogicalType": {
      "description": "The logical types of the Open Data Contract Standard v3.",
      "type": "string",
      "enum": [
        "string",
        "date",
        "timestamp",
        "time",
        "number",
        "integer",
        "object",
        "array",
        "boolean"
      ]
    },
    "Monotonic": {
      "type": "string",
      "enum": [
        "increasing",
        "decreasing",
        "none"
      ]
    },
    "NumericExtremes": {
      "type": "object",
      "properties": {
        "high": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "low": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtremesMethod"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NumericStats": {
      "type": "object",
      "properties": {
        "extremes": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericExtremes"
            },
            {
              "type": "null"
